NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/asistencias_nsr

# JWT — cambia en producción con: openssl rand -base64 64
JWT_SECRET=CAMBIA_ESTO_EN_PRODUCCION_openssl_rand_-base64_64
JWT_EXPIRES_IN=8h

# CORS — origen del frontend
FRONTEND_URL=http://localhost:5173

# Zona horaria del colegio
TZ=America/Lima
