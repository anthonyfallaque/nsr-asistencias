NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/asistencias_nsr

# JWT — mínimo 32 caracteres. Genera uno con: openssl rand -base64 64
# El proceso NO arranca si falta o es más corto.
JWT_SECRET=CAMBIA_ESTO_EN_PRODUCCION_openssl_rand_-base64_64
JWT_EXPIRES_IN=8h

# CORS — origen del frontend
FRONTEND_URL=http://localhost:5173

# Zona horaria del colegio.
# En Alpine hace falta el paquete tzdata (ya incluido en el Dockerfile);
# sin él la variable no resuelve y el proceso se queda en UTC.
TZ=America/Lima
